{
  "name": "lfscloud",
  "displayName": "LFS Cloud",
  "version": "0.2.6",
  "publisher": "Quicksaver",
  "license": "MIT",
  "private": true,
  "packageManager": "yarn@4.14.1",
  "scripts": {
    "build:linux-arm64": "CARGO_TARGET_AARCH64_UNKNOWN_LINUX_MUSL_LINKER=musl-gcc CC_aarch64_unknown_linux_musl=musl-gcc cargo build --release --target aarch64-unknown-linux-musl",
    "build:linux-x86-64": "CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_LINKER=musl-gcc CC_x86_64_unknown_linux_musl=musl-gcc cargo build --release --target x86_64-unknown-linux-musl",
    "build:macos": "cargo build --release --target aarch64-apple-darwin",
    "build:windows": "cargo build --release --target x86_64-pc-windows-msvc",
    "lint:check": "yarn lint:prettier",
    "lint:fix": "yarn lint:prettier --write",
    "lint:prettier": "prettier --log-level=warn --check .",
    "merge": "./scripts/git/merge.sh",
    "release:all": "./scripts/release-all.sh",
    "release:local": "./scripts/release.sh",
    "release:publish": "./scripts/publish.sh",
    "release:windows": "pwsh -NoProfile -File ./scripts/release.ps1",
    "rotate:github": "./scripts/keys/github.sh",
    "rotate:google-drive": "./scripts/keys/google-drive.sh",
    "rotate:slack": "./scripts/keys/slack.sh",
    "test:release-all": "./scripts/tests/release-all.sh",
    "test:release-scripts": "./scripts/tests/release-scripts.sh",
    "test:release-windows": "pwsh -NoProfile -File ./scripts/tests/release-windows.ps1",
    "test:publish-release": "./scripts/tests/publish-release.sh",
    "test:install-scripts": "./scripts/tests/install-scripts.sh && pwsh -NoProfile -File ./scripts/tests/install-powershell.ps1",
    "test:verify-windows": "pwsh -NoProfile -File ./scripts/tests/verify-windows.ps1",
    "verify:all": "./scripts/local/verify-all.sh",
    "verify:linux-arm64": "./scripts/local/verify-linux-arm64.sh",
    "verify:linux-x86-64": "./scripts/local/verify-linux-x86-64.sh",
    "verify:macos": "./scripts/local/verify-macos.sh",
    "verify:windows": "pwsh -NoProfile -File ./scripts/local/verify-windows.ps1"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "prettier": "^3.8.3"
  }
}
